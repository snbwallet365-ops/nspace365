# Workspace keys — set these and the app works with no pasting.
# Gemini is the default browser-agent brain.
GEMINI_API_KEY_2=
GEMINI_API_KEY=
# Optional: provider keys used when a user has not pasted their own.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# GitHub sync (server side)
GITHUB_TOKEN_SNB=
GITHUB_TOKEN_NASIM=
# Postgres for the live session store
DATABASE_URL=
# Optional: path to a Chromium binary for the Playwright browser agent
PLAYWRIGHT_CHROMIUM_PATH=
